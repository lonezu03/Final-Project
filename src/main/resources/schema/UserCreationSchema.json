{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "UserCreationSchema",
  "type": "object",
  "properties": {
    "passwordUser": {
      "type": "string",
      "minLength": 8,
      "maxLength": 255,
      "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[!@#$%^&*])[^\\s]{1,}$"

    },
    "emailUser": {
      "type": "string",
      "format": "email"
    }
  },
  "required": ["passwordUser", "emailUser"],
  "additionalProperties": false
}
