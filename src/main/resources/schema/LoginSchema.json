{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LoginSchema.json",
    "properties": {
        "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
        },
        "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 255,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[!@#$%^&*])[^\\s]{1,}$"
        }
    },
    "required": [
        "email",
        "password"
    ]
}