{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "UserUpdatePasswordSchema",
  "type": "object",
  "properties": {
	"idUser":{
		"type":"string"
	},
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 255,
      "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[!@#$%^&*])[^\\s]{1,}$"

    }
  },
  "required": ["idUser", "password"],
  "additionalProperties": false
}
