{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "NovelUpdateSchema",
  "type": "object",
  "properties": {
    "idNovel": {
      "type": "string"
    },
    "nameNovel": {
      "type": ["string", "null"]
    },
    "descriptionNovel": {
      "type": ["string", "null"]
    },
    "totalChapter": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "rating": {
      "type": ["string", "null"]
    },
    "statusNovel": {
      "type": ["string", "null"],
      "enum": ["COMPLETED","CONTINUE","DROP" ]  
    }
  },
  "required": ["idNovel"],
  "additionalProperties": false
}
