{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "NovelSearchCriteriaSchema",
  "type": "object",
  "properties": {
    "nameNovel": {
      "type": ["string", "null"]
    },
    "nameOperator": {
      "type": ["string", "null"],
      "enum": ["EQUALS", "CONTAINS"]
    },
    "ratingGreaterThanOrEqual": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "totalChapterGreaterThan": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "totalChapterLessThan": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "statuses": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "authorNames": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "categoryNames": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
